# ============================================
# AIサービス利用状況管理 環境変数設定
# ============================================
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
# ============================================

# --- Cursor API ---
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_API_BASE_URL=https://www.cursor.com/api

# --- Codex ログイン情報 ---
CODEX_LOGIN_EMAIL=your_codex_email@example.com
CODEX_LOGIN_PASSWORD=your_codex_password_here
CODEX_DASHBOARD_URL=https://platform.openai.com/usage

# --- Claude Code ログイン情報 ---
CLAUDE_LOGIN_EMAIL=your_claude_email@example.com
CLAUDE_LOGIN_PASSWORD=your_claude_password_here
CLAUDE_DASHBOARD_URL=https://console.anthropic.com/settings/usage

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_STATE_DIR=playwright_state

# --- ログ設定 ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- スクリーンショット保存先 ---
SCREENSHOT_DIR=screenshots
